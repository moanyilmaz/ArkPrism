{
  "schemaVersion": 1,
  "definition": "A positive case has an explicit value dependence from the configured privacy-data carrier to console.info. Framework-input paths do not satisfy the oracle.",
  "cases": [
    {
      "id": "T1_callback__oaid__callback_inline_data",
      "api": "oaid",
      "construct": "T1-callback",
      "expected": true,
      "rationale": "Inline callback sends the configured data parameter to the sink.",
      "sourceFile": "entryability/EntryAbility.ets"
    },
    {
      "id": "T1_callback__oaid__callback_alias_data",
      "api": "oaid",
      "construct": "T1-callback",
      "expected": true,
      "rationale": "Inline callback aliases the configured data parameter before the sink.",
      "sourceFile": "entryability/EntryAbility.ets"
    },
    {
      "id": "T1_callback__oaid__callback_named_data",
      "api": "oaid",
      "construct": "T1-callback",
