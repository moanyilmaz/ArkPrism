      "sourceFile": "entryability/EntryAbility.ets"
    },
    {
      "id": "T1_callback__oaid__callback_error_only",
      "api": "oaid",
      "construct": "T1-callback",
      "expected": false,
      "rationale": "Only the callback error parameter reaches the sink.",
      "sourceFile": "entryability/EntryAbility.ets"
    },
    {
