{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Enhanced data sink rules for privacy data flow tracking - v2.0",
  "version": "2.0.0",
  "updated": "2026-05-21",

  "sinkCategories": {
    "network": {
      "description": "APIs that send data over network (data exfiltration)",
      "severity": "critical",
      "patterns": [
        {
          "namespace": "http",
          "methods": ["request", "requestInStream", "on"],
          "api": "http.HttpRequest",
          "kit": "@kit.NetworkKit"
        },
        {
          "namespace": "http",
          "methods": ["request", "requestInStream"],
          "api": "http.Http",
          "kit": "@kit.NetworkKit"
        },
        {
          "namespace": "rcp",
          "methods": ["fetch", "get", "post", "put", "delete", "sendRequest"],
          "api": "rcp.Session",
          "kit": "@kit.RemoteCommunicationKit"
        },
        {
          "namespace": "webSocket",
          "methods": ["send", "sendPartialMessage"],
          "api": "webSocket.WebSocket",
          "kit": "@kit.NetworkKit"
        },
        {
          "namespace": "socket",
          "methods": ["send", "sendArrayBuffer"],
          "api": "socket.Socket",
          "kit": "@kit.NetworkKit"
        },
        {
          "namespace": "TCPSocket",
          "methods": ["send", "sendArrayBuffer"],
          "api": "TCPSocket",
          "kit": "@kit.NetworkKit"
        },
        {
          "namespace": "UDPSocket",
          "methods": ["send", "sendArrayBuffer"],
          "api": "UDPSocket",
          "kit": "@kit.NetworkKit"
        },
        {
          "namespace": "TLSSocket",
          "methods": ["send", "sendArrayBuffer"],
          "api": "TLSSocket",
          "kit": "@kit.NetworkKit"
        },
        {
          "namespace": "request",
          "methods": ["uploadFile", "downloadFile"],
          "api": "request.downloadTask",
          "kit": "@kit.BasicServicesKit"
        },
        {
          "namespace": "request",
          "methods": ["on", "off", "once"],
          "api": "request.downloadTask",
          "kit": "@kit.BasicServicesKit"
        },
        {
          "namespace": "wifiManager",
          "methods": ["scan", "connectToDevice"],
          "api": "wifiManager",
          "kit": "@ohos.wifiManager"
        },
        {
          "namespace": "ble",
          "methods": ["writeCharacteristicValue", "sendData"],
          "api": "ble.GattClientDevice",
          "kit": "@ohos.bluetooth.ble"
        }
      ]
    },

    "storage": {
      "description": "APIs that persist data locally (data retention)",
      "severity": "high",
      "patterns": [
        {
          "namespace": "preferences",
          "methods": ["put", "putSync", "flushSync"],
          "api": "preferences.Preferences",
          "kit": "@kit.ArkData"
        },
        {
          "namespace": "Preferences",
          "methods": ["put", "putSync", "flushSync"],
          "api": "dataPreferences.Preferences",
          "kit": "@kit.ArkData"
        },
        {
          "namespace": "dataPreferences",
          "methods": ["put", "putSync", "flushSync"],
          "api": "dataPreferences",
          "kit": "@kit.ArkData"
        },
        {
          "namespace": "rdb",
          "methods": ["insert", "update", "delete", "batchInsert", "executeSql"],
          "api": "rdb.RdbStore",
          "kit": "@kit.ArkData"
        },
        {
          "namespace": "RdbStore",
          "methods": ["insert", "update", "delete", "batchInsert"],
          "api": "relationalStore.RdbStore",
          "kit": "@kit.ArkData"
        },
        {
          "namespace": "relationalStore",
          "methods": ["insert", "update", "delete", "batchInsert"],
          "api": "relationalStore",
          "kit": "@kit.ArkData"
        },
        {
          "namespace": "distributedKVStore",
          "methods": ["put", "putSync", "batchPut", "batchPutSync"],
          "api": "distributedKVStore.SingleKVStore",
          "kit": "@kit.DistributedServiceKit"
        },
        {
          "namespace": "kvStore",
          "methods": ["put", "putSync", "batchPut"],
          "api": "distributedKVStore",
          "kit": "@kit.DistributedServiceKit"
        },
        {
          "namespace": "distributedData",
          "methods": ["put", "putSync"],
          "api": "distributedData.AppDataHub",
          "kit": "@ohos.data.distributedData"
        },
        {
          "namespace": "fs",
          "methods": ["write", "writeSync", "writeFile", "writeFileSync", "appendFile", "appendFileSync"],
          "api": "fs",
          "kit": "@kit.CoreFileKit"
        },
        {
          "namespace": "fileio",
          "methods": ["writeFile", "writeFileSync", "appendFile", "appendFileSync"],
          "api": "fileio",
          "kit": "@ohos.fileio"
        },
        {
          "namespace": "photoAccessHelper",
          "methods": ["createAsset", "modifyAsset", "delete"],
          "api": "photoAccessHelper.PhotoAccessHelper",
          "kit": "@ohos.file.photoAccessHelper"
        },
        {
          "namespace": "pasteboard",
          "methods": ["setData", "setPrimaryData", "setClipboardData"],
          "api": "pasteboard.SystemPasteboard",
          "kit": "@kit.BasicServicesKit"
        }
      ]
    },

    "ui_display": {
      "description": "APIs that display data in UI (data exposure to user)",
      "severity": "medium",
      "patterns": [
        {
          "namespace": "Text",
          "methods": ["create", "setText"],
          "api": "Text",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "TextInput",
          "methods": ["create", "setText", "setValue"],
          "api": "TextInput",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "TextArea",
          "methods": ["create", "setText", "setValue"],
          "api": "TextArea",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "RichText",
          "methods": ["create", "setRichText"],
          "api": "RichText",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "Image",
          "methods": ["create"],
          "api": "Image",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "List",
          "methods": ["create"],
          "api": "List",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "ListItem",
          "methods": ["create"],
          "api": "ListItem",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "ForEach",
          "methods": ["create"],
          "api": "ForEach",
          "kit": "@kit.ArkUI"
        },
        {
          "namespace": "LazyForEach",
          "methods": ["create"],
          "api": "LazyForEach",
          "kit": "@kit.ArkUI"
        }
      ]
    },

    "log": {
      "description": "APIs that log data (potential telemetry/debug leakage)",
      "severity": "medium",
      "patterns": [
        {
          "namespace": "console",
          "methods": ["log", "info", "warn", "error", "debug", "trace", "table"],
          "api": "console",
          "kit": "builtin"
        },
        {
          "namespace": "hilog",
          "methods": ["debug", "info", "warn", "error", "fatal"],
          "api": "hilog",
          "kit": "@ohos.hilog"
        },
        {
          "namespace": "Logger",
          "methods": ["debug", "info", "warn", "error"],
          "api": "Logger",
          "kit": "@ohos.faultLogger"
        },
        {
          "namespace": "printLog",
          "methods": ["printLog"],
          "api": "hiLog",
          "kit": "@ohos.hilog"
        },
        {
          "namespace": "HiLog",
          "methods": ["debug", "info", "warn", "error"],
          "api": "HiLog",
          "kit": "@ohos.hilog"
        }
      ]
    },

    "intent": {
      "description": "APIs that send data via Intent/Ability (data sharing between apps)",
      "severity": "high",
      "patterns": [
        {
          "namespace": "want",
          "methods": ["addFlags", "setFlags"],
          "api": "want.Want",
          "kit": "@ohos.app.ability.Want"
        },
        {
          "namespace": "wantAgent",
          "methods": ["getWant", "cancel"],
          "api": "wantAgent",
          "kit": "@ohos.wantAgent"
        },
        {
          "namespace": "abilityAccessCtrl",
          "methods": ["onRequestPermissionsFromUserResult"],
          "api": "abilityAccessCtrl",
          "kit": "@ohos.abilityAccessCtrl"
        }
      ]
    },

    "share": {
      "description": "APIs that share data with other apps or services",
      "severity": "high",
      "patterns": [
        {
          "namespace": "share",
          "methods": ["shareSystemSharedUri"],
          "api": "share.ShareOption",
          "kit": "@kit.BasicServicesKit"
        },
        {
          "namespace": "picker",
          "methods": ["save", "publish"],
          "api": "picker",
          "kit": "@ohos.file.picker"
        },
        {
          "namespace": "fileAccess",
          "methods": ["share"],
          "api": "fileAccess",
          "kit": "@ohos.file.fileAccess"
        }
      ]
    }
  },

  "metadata": {
    "sources": [
      "HarmonyOS NEXT Developer Documentation",
      "OpenHarmony API Reference",
      "Android Privacy Leak Detection Literature (FlowDroid, Amandroid)",
      "DroidBench Test Suite"
    ],
    "references": [
      "SEAndroid: Towards Mandatory MAC in Android",
      "FlowDroid: Precise Static Data Flow Analysis of Android",
      "Amandroid: A Precise and General Inter-component Data Flow Analysis"
    ],
    "lastUpdated": "2026-05-21",
    "maintainer": "ArkPrism Team",
    "notes": "Sink rules follow Android taint analysis conventions: network=critical, storage=high, intent=high, log=medium"
  }
}