{
  "name": "arkprism",
  "version": "1.0.0",
  "description": "ArkPrism: ArkTS privacy-sensitive API recognition and information-flow evidence",
  "main": "dist/arkprism.js",
  "scripts": {
    "analyze": "ts-node src/arkprism.ts",
    "batch": "ts-node src/arkprism.ts --batch",
    "build": "tsc",
    "test": "npm run test:delivery",
    "test:delivery": "npm run build && node scripts/run_delivery_checks.js",
    "test:corpus-summary": "node tests/verify_corpus_summary.js",
    "test:call-chain-dominators": "npm run build && node tests/verify_call_chain_dominators.js",
    "test:ifds-incoming-identity": "npm run build && node tests/verify_ifds_incoming_identity.js",
    "test:ifds-malformed-cfg": "npm run build && node tests/verify_ifds_malformed_cfg.js",
    "test:ifds-parameter-mapping": "npm run build && node tests/verify_ifds_parameter_mapping.js",
    "test:api-usage-dedup": "npm run build && node tests/verify_api_usage_dedup.js",
    "test:manager-receiver": "npm run build && node tests/verify_manager_receiver.js",
    "test:pta-container-edges": "npm run build && node tests/verify_pta_container_edges.js",
    "test:runner-strictness": "node tests/verify_runner_strictness.js",
    "test:taint-flow-dedup": "npm run build && node tests/verify_taint_flow_dedup.js",
    "test:taint-source-evidence": "npm run build && node tests/verify_taint_source_evidence.js",
    "test:promise-continuation": "npm run build && node tests/verify_promise_continuation_provenance.js",
    "test:evidence-linker": "npm run build && node tests/verify_evidence_linker.js",
    "test:evidence-universes": "node tests/verify_evidence_universe_audit.js",
    "test:source-audit-export": "node tests/verify_source_audit_export.js",
    "test:rule-deduplication": "node tests/verify_rule_deduplication.js",
    "test:detector-domain-migration": "node tests/verify_detector_domain_migration.js",
    "test:package-aliases": "node tests/verify_package_aliases.js",
    "test:hapbench-oracle-sensitivity": "node tests/verify_hapbench_oracle_sensitivity.js",
    "test:hapbench-endpoint-pairs": "node tests/verify_hapbench_endpoint_pair_audit.js",
    "test:source-first-gold": "node tests/verify_source_first_gold.js",
    "test:redundancy-sensitivity": "node tests/verify_redundancy_sensitivity.js",
    "test:taint-value-dependency": "npm run build && node tests/verify_taint_value_dependency.js",
    "test:fuzzy-source-identity": "npm run build && node tests/verify_fuzzy_source_identity.js",
    "test:source-rule-contract": "npm run build && node tests/verify_source_rule_contract.js",
    "test:taint-report-comparison": "node tests/verify_taint_report_comparison.js",
    "test:top120": "node tests/verify_top120_benchmark.js && node tests/verify_top120_source_packager.js",
    "audit:rules": "node scripts/audit_rule_sets.js",
    "audit:sdk20-sources": "npm run build && node scripts/audit_sdk_source_resolution.js",
    "audit:sdk20-framework-sources": "npm run build && node scripts/audit_sdk_source_resolution.js --sources config/lifecycle_sources.json --output docs/rule_set_audit/framework_source_rule_sdk20_resolution_audit.json",
    "audit:source-audit": "node scripts/audit_source_audit_artifact.js",
    "benchmark:top120": "node scripts/run_top120_benchmark.js",
    "evaluate:top120": "node scripts/evaluate_top120_benchmark.js",
    "package:top120-sources": "node scripts/package_top120_sources.js",
    "verify:top120-sources": "node scripts/verify_top120_source_package.js",
    "analyze:hapbench-oracle-sensitivity": "node scripts/analyze_hapbench_oracle_sensitivity.js",
    "generate:arkasyncbench": "node scripts/generate_arkasyncbench.js",
    "generate:arkpromisebench": "node scripts/generate_arkpromisebench.js",
    "generate:arkidentitybench": "node scripts/generate_arkidentitybench.js",
    "select:source-first-audit": "node scripts/select_source_first_audit.js",
    "generate:source-first-review": "node scripts/generate_source_first_review_queue.js",
    "build:source-first-gold": "node scripts/build_source_first_gold.js",
    "evaluate:source-first": "node scripts/evaluate_source_first_gold.js",
    "migrate:sdk20-source-rules": "node scripts/resolve_unknown_source_rules.js",
    "migrate:sdk20-source-parameters": "node scripts/normalize_sdk20_source_parameters.js",
    "migrate:detector-properties": "node scripts/normalize_detector_property_rules.js",
    "start": "ts-node src/arkprism.ts"
  },
  "keywords": [
    "harmonyos",
    "arkts",
    "privacy",
    "static-analysis",
    "arkanalyzer",
    "call-graph",
    "information-flow"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "11.0.0",
    "json5": "^2.2.3",
    "log4js": "6.7.1",
    "ohos-typescript": "^4.9.5-r6"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
